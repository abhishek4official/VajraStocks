{
  "name": "breakout_scan",
  "description": "Scans the entire stock database to isolate high-volume momentum breakout candidates.",
  "steps": [
    {
      "step_index": 1,
      "agent": "market_regime_agent",
      "action": "assess_broad_market",
      "required_inputs": []
    },
    {
      "step_index": 2,
      "agent": "opportunity_scanner_agent",
      "action": "scan_all_breakouts",
      "required_inputs": ["market_regime"]
    },
    {
      "step_index": 3,
      "agent": "report_agent",
      "action": "compile_opportunities_report",
      "required_inputs": ["market_regime", "scanned_opportunities"]
    }
  ]
}
