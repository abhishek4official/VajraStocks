{
  "name": "swing_trade_scan",
  "description": "Orchestrates a full-scale scan to isolate, score, and plan tactical entries for swing trading setups.",
  "steps": [
    {
      "step_index": 1,
      "agent": "market_regime_agent",
      "action": "assess_broad_market",
      "required_inputs": []
    },
    {
      "step_index": 2,
      "agent": "opportunity_scanner_agent",
      "action": "scan_reversal_setups",
      "required_inputs": ["market_regime"]
    },
    {
      "step_index": 3,
      "agent": "stock_analysis_agent",
      "action": "score_filtered_candidates",
      "required_inputs": ["scanned_opportunities"]
    },
    {
      "step_index": 4,
      "agent": "trade_planner_agent",
      "action": "plan_entries_and_stops",
      "required_inputs": ["scanned_opportunities", "analysis_scores"]
    },
    {
      "step_index": 5,
      "agent": "report_agent",
      "action": "synthesize_swing_report",
      "required_inputs": ["market_regime", "trade_plans"]
    }
  ]
}
