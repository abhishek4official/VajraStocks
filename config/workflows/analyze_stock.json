{
  "name": "analyze_stock",
  "description": "Performs deep technical analysis, quantitative scoring, risk profiling, and trade planning for a single ticker.",
  "steps": [
    {
      "step_index": 1,
      "agent": "sql_data_agent",
      "action": "query_stock_history",
      "required_inputs": ["symbol"]
    },
    {
      "step_index": 2,
      "agent": "stock_analysis_agent",
      "action": "score_trends_and_momentum",
      "required_inputs": ["sql_data"]
    },
    {
      "step_index": 3,
      "agent": "trade_planner_agent",
      "action": "generate_atr_trade_plan",
      "required_inputs": ["sql_data", "analysis_scores"]
    },
    {
      "step_index": 4,
      "agent": "report_agent",
      "action": "synthesize_report",
      "required_inputs": ["analysis_scores", "trade_plan"]
    }
  ]
}
