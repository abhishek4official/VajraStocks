{
  "name": "vajrastocks-electron",
  "version": "2.1.0",
  "description": "Electron desktop shell for VajraStocks",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.abhishek.vajrastocks",
    "productName": "VajraStocks",
    "copyright": "Copyright 2026 Abhishek Kumar",
    "asar": true,
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "../installer/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VajraStocks",
      "installerIcon": "../installer/assets/icon.ico",
      "uninstallerIcon": "../installer/assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "icon": "../installer/assets/icon.icns",
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": "AppImage",
      "icon": "../installer/assets/icon.png",
      "category": "Finance"
    },
    "extraResources": [
      { "from": "../dist/VajraStocks", "to": "backend", "filter": ["**/*"] }
    ],
    "files": ["main.js", "loading.html", "error.html"],
    "directories": { "output": "../release" }
  }
}