# ==========================================
# Python Gitignore
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Pyinstaller
#  Usually these written by a python runner on a windows machine
*.manifest
*.spec
# Keep the checked-in installer spec
!installer/vajrastocks.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nosenv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# Translations
*.mo
*.pot

# SQLite database caches / backups
db.sqlite3
db.sqlite3-journal

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
#   For a python version manager
.python-version

# PEP 582; project local packages directory (used by pdm)
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath vars
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site/

# mypy
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/


# ==========================================
# Node.js / React / Vite Gitignore
# ==========================================

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-modules
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output directory for Vite build
dist-ssr/
.vite/

# Next.js build output
.next/
out/

# Rollup progress files
.rollup.cache

# Gatsby files
.cache/
public/

# dotenv environment variable files
.env.development.local
.env.test.local
.env.write-only.local
.env.production.local
.env.local
.env.*.local

# Serverless Webpack directories
.webpack/

# Bundler caches
.parcel-cache

# ==========================================
# IDEs, Editors & OS Files
# ==========================================

# VS Code settings
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# JetBrains IDEs (PyCharm, WebStorm, etc.)
.idea/

# OS metadata
.DS_Store
Thumbs.db

# SQL Server LocalDB local database backups or local attachments if created inside repo
*.mdf
*.ldf


# ==========================================
# Flutter / Dart Gitignore
# ==========================================
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/build/
**/coverage/
app.*.symbols
app.*.map.json
/android/app/debug
/android/app/profile
/android/app/release
*.apk
*.ap_
*.app
*.ipa
*.keystore
*.jks
local.properties
key.properties


# VajraStocks local data (SQLite) and runtime
# NOTE: anchored to repo root so it does NOT match the source package src/stocks/data/
python/data/
python/logs/
/data/
vajra.db
vajra.db-*
*.db-journal
VajraML/results/
VajraML/models/
VajraML2/results/
VajraML2/models/
VajraML2/*.log


# ==========================================
# Electron / Desktop build artifacts
# ==========================================

# electron-builder output (installers, unpacked app)
release/
release-beta/

# PyInstaller bundle (lives inside python/)
python/dist/

# electron-builder intermediate cache
electron/.cache/

# electron-builder effective config dump
release/builder-effective-config.yaml


